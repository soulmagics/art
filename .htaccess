Options -Indexes
DirectoryIndex index.php
RewriteEngine On
RewriteRule ^\.git(?:/|$) - [F,L,NC]
RewriteRule ^(?:upload|archive|map|live|admin|account)/?$ index.php [L]
<IfModule mod_headers.c>
<FilesMatch "\.(?:js|css)$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>
<FilesMatch "^\.">
Require all denied
</FilesMatch>
